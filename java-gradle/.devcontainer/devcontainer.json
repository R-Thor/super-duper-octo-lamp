{
  "name": "Java-Gradle",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Ensures VS Code installs Java UI extensions inside the container too
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  },
  // Use the vscode user for correct permissions
  "remoteUser": "vscode",
  "updateRemoteUserUID": true
}
